      </item>
      <item>
       <widget class="QLabel" name="label_9">
        <property name="text">
         <string>Use title from ini file: If game is RPG Maker XP/VX/VX Ace or RM2K/2003, it may not necessarily contain game title in the system file. Use this option to take it from Game.ini (XP/VX/VX Ace) or RPG_RT.ini (RM2K/2003), whichever is present in the game directory. You will have to pick the right encoding in &quot;Text Encoding&quot; field above. If the title comes out garbled, that's a hint the encoding is wrong. If this option is not set, we'll try to use the title from system file, if it's there.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
