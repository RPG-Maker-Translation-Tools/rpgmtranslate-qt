Checks: "clang-analyzer-*, modernize-*, llvm-*, bugprone-*, readability-*, performance-*, misc-*, -bugprone-easily-swappable-parameters, -readability-function-cognitive-complexity, -misc-include-cleaner, -readability-isolate-declaration, -clang-analyzer-optin.core.EnumCastOutOfRange, -bugprone-exception-escape, -misc-non-private-member-variables-in-classes, -bugprone-throwing-static-initialization, -llvm-prefer-static-over-anonymous-namespace, -readability-trailing-comma, -misc-override-with-different-visibility, -llvm-header-guard, -performance-no-int-to-ptr, -readability-magic-numbers, -bugprone-signed-bitwise, -bugprone-derived-method-shadowing-base-method"
ExcludeHeaderFilterRegex: '[\\/](3rdparty|build)[\\/]'
